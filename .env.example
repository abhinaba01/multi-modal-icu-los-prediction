# Copy to .env on each machine (git-ignored) and fill in. Never commit .env.
# Relative paths resolve against the repository root.

# laptop | lab | gcp | kaggle  (realdata tests run only when this is "lab" or "gcp")
FATE_MACHINE=laptop

# SQLAlchemy URL of the MIMIC-IV PostgreSQL database.
#   laptop: the open demo database        lab: the full credentialed database
# Format: postgresql+psycopg://<user>:<password>@localhost:5432/mimiciv_demo
FATE_DB_URL=

# Output locations (all git-ignored and read-denied for Claude Code)
FATE_DATA_DIR=data
FATE_ARTIFACTS_DIR=artifacts
FATE_OUTPUTS_DIR=outputs
FATE_REPORTS_DIR=reports
FATE_CHECKPOINTS_DIR=checkpoints

# auto | cpu | cuda
FATE_DEVICE=auto

# Laptop only: the unpacked open MIMIC-IV demo (folder containing hosp/ and icu/).
# Used by the demo tests that compare the legacy CSV reader with PostgreSQL.
MIMIC_DEMO_DIR=

# Lab only: the full MIMIC-IV v3.1 CSV folder (hosp/, icu/) for the legacy scripts.
# Keep it commented out on the laptop: the legacy code lets this variable override
# its config, even when empty.
# MIMIC_RAW_DIR=

# Lab only: the MIMIC-CXR-JPG 2.1.0 folder that holds mimic-cxr-2.0.0-metadata.csv.gz and,
# after the Stage 1 download, the selected images under files/ (docs/lab_runbook.md).
MIMIC_CXR_DIR=

# Public CMS 2018 ICD-9 -> ICD-10 GEM file (2018_I9gem.txt), needed by the legacy
# diagnosis features that define the contract cohort.
ICD9_GEM_PATH=

# Stage 5 (RAG layer, public data only): folder for the downloaded corpora, the passage
# corpus, the indexes and the query bank (several GB). On the laptop keep it outside
# OneDrive, e.g. C:\fate-data\rag: the full build stops if it is inside a OneDrive folder.
# Empty = <FATE_ARTIFACTS_DIR>/rag.
FATE_RAG_DIR=

# Stage 5, laptop only: NCBI E-utilities (the PubMed download). NCBI asks every client for
# a contact email, which is sent to NCBI with each request; the code never prints or logs
# it. The API key is optional (free from your NCBI account: Account settings > API Key
# Management) and raises NCBI's limit from 3 to 10 requests per second.
NCBI_EMAIL=
NCBI_API_KEY=
