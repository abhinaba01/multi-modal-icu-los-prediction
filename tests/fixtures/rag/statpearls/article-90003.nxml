      <title-group><title>Septic Shock</title></title-group>
      <contrib-group><contrib contrib-type="author"><name><surname>Haddad</surname><given-names>Samir</given-names></name></contrib></contrib-group>
      <pub-history><date date-type="updated"><year>2023</year></date></pub-history>
